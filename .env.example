# Copy to `.env` (for docker compose) and/or `.env.local` (for `npm run dev`
# on the host). Both are gitignored. docker-compose.yml reads `.env`.

# --- HCGateway backend ---------------------------------------------------
# REST API origin. Credentials are exchanged for a bearer token at
# POST $API_URL/api/v2/login.
API_URL="http://192.168.8.239:6644"
API_USERNAME=lucas
API_PASSWORD=

# Optional. The GraphQL API runs as its own service on port 6645; when unset,
# it is derived from API_URL by swapping the port, so you rarely need this.
# GRAPHQL_URL="http://192.168.8.239:6645/graphql"

# --- Legacy pipeline only ------------------------------------------------
# These configure the in-repo analytics pipeline, which still runs for pages
# that haven't been migrated to GraphQL (see GRAPHQL_MIGRATION_REDUNDANCY.md
# and the migration notice at the top of each page). Migrated pages take the
# equivalent settings from HCGateway's own analytics config instead, so
# changing these will NOT affect them.
HEALTH_HOME_TIME_ZONE="America/Chicago"
SLEEP_TARGET_MINUTES="480"
HEALTH_BIRTH_DATE="1990-01-31"

# Optional Mongo persistence for standalone pipeline runs (`npm run
# pipeline:run`). Not needed to serve the app.
# ANALYTICS_MONGO_URI="mongodb://analytics_user:password@mongo:27017"
# ANALYTICS_DATABASE="health_analytics"

# Extra origins allowed to reach the dev server, when running it on the LAN.
# DEV_ALLOWED_ORIGINS="192.168.8.239"

# --- Compose port overrides ----------------------------------------------
# PROD_PORT=3000
# DEV_PORT=3001
