# Copy to `.env` (for docker compose / scripts/deploy.sh) and/or `.env.local`
# (for `npm run dev` on the host). Both are gitignored. docker-compose.yml
# reads `.env`. API_URL is required: without it every page shows the
# "Couldn't load health data" error. There are no account credentials here;
# people sign in on /login with their HCGateway account.

# --- HCGateway backend ---------------------------------------------------
# REST API origin. The /login page exchanges a person's HCGateway username
# and password for a session token at POST $API_URL/api/v2/login.
API_URL="http://192.168.8.239:6644"

# Optional. The GraphQL API runs as its own service on port 6645; when unset,
# it is derived from API_URL by swapping the port, so you rarely need this.
# GRAPHQL_URL="http://192.168.8.239:6645/graphql"

# Home time zone, sleep target and birth date are NOT set here: they live in
# HCGateway's analytics config (PUT $API_URL/api/v2/analytics/config).

# --- Development ---------------------------------------------------------
# Extra origins allowed to reach the dev server, when running it on the LAN.
# DEV_ALLOWED_ORIGINS="192.168.8.239"

# --- Compose port overrides ----------------------------------------------
# PROD_PORT=3000
# DEV_PORT=3001
